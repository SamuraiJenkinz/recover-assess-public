{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "AgeBuckets": {
      "additionalProperties": false,
      "description": "Share of files by age of last modification.",
      "properties": {
        "lt_1y": {
          "maximum": 1,
          "minimum": 0,
          "title": "Lt 1Y",
          "type": "number"
        },
        "y1_3": {
          "maximum": 1,
          "minimum": 0,
          "title": "Y1 3",
          "type": "number"
        },
        "gt_3y": {
          "maximum": 1,
          "minimum": 0,
          "title": "Gt 3Y",
          "type": "number"
        }
      },
      "required": [
        "lt_1y",
        "y1_3",
        "gt_3y"
      ],
      "title": "AgeBuckets",
      "type": "object"
    },
    "CategoryShares": {
      "additionalProperties": false,
      "description": "Share of files per content category; each share is 0..1.",
      "properties": {
        "word": {
          "maximum": 1,
          "minimum": 0,
          "title": "Word",
          "type": "number"
        },
        "pdf": {
          "maximum": 1,
          "minimum": 0,
          "title": "Pdf",
          "type": "number"
        },
        "excel": {
          "maximum": 1,
          "minimum": 0,
          "title": "Excel",
          "type": "number"
        },
        "powerpoint": {
          "maximum": 1,
          "minimum": 0,
          "title": "Powerpoint",
          "type": "number"
        },
        "email": {
          "maximum": 1,
          "minimum": 0,
          "title": "Email",
          "type": "number"
        },
        "image": {
          "maximum": 1,
          "minimum": 0,
          "title": "Image",
          "type": "number"
        },
        "text": {
          "maximum": 1,
          "minimum": 0,
          "title": "Text",
          "type": "number"
        },
        "archive": {
          "maximum": 1,
          "minimum": 0,
          "title": "Archive",
          "type": "number"
        },
        "other": {
          "maximum": 1,
          "minimum": 0,
          "title": "Other",
          "type": "number"
        }
      },
      "required": [
        "word",
        "pdf",
        "excel",
        "powerpoint",
        "email",
        "image",
        "text",
        "archive",
        "other"
      ],
      "title": "CategoryShares",
      "type": "object"
    },
    "CollectLimits": {
      "additionalProperties": false,
      "description": "The caps and sample sizes this run was collected under.",
      "properties": {
        "max_items_per_library": {
          "minimum": 1,
          "title": "Max Items Per Library",
          "type": "integer"
        },
        "fill_rate_sample": {
          "minimum": 1,
          "title": "Fill Rate Sample",
          "type": "integer"
        },
        "permission_checks_per_library": {
          "minimum": 1,
          "title": "Permission Checks Per Library",
          "type": "integer"
        },
        "max_file_mb": {
          "minimum": 1,
          "title": "Max File Mb",
          "type": "integer"
        },
        "sample_size": {
          "minimum": 0,
          "title": "Sample Size",
          "type": "integer"
        }
      },
      "required": [
        "max_items_per_library",
        "fill_rate_sample",
        "permission_checks_per_library",
        "max_file_mb",
        "sample_size"
      ],
      "title": "CollectLimits",
      "type": "object"
    },
    "Column": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "display_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Display Name"
        },
        "type": {
          "enum": [
            "text",
            "choice",
            "dateTime",
            "number",
            "boolean",
            "personOrGroup",
            "lookup",
            "term",
            "calculated",
            "other"
          ],
          "title": "Type",
          "type": "string"
        },
        "required": {
          "title": "Required",
          "type": "boolean"
        },
        "custom": {
          "title": "Custom",
          "type": "boolean"
        },
        "choices": {
          "items": {
            "type": "string"
          },
          "title": "Choices",
          "type": "array"
        },
        "term_set_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Term Set Id"
        },
        "fill_rate": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Fill Rate"
        }
      },
      "required": [
        "name",
        "display_name",
        "type",
        "required",
        "custom",
        "choices",
        "term_set_id",
        "fill_rate"
      ],
      "title": "Column",
      "type": "object"
    },
    "Contributor": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "files_modified_365d": {
          "minimum": 0,
          "title": "Files Modified 365D",
          "type": "integer"
        },
        "last": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Last"
        }
      },
      "required": [
        "id",
        "files_modified_365d",
        "last"
      ],
      "title": "Contributor",
      "type": "object"
    },
    "Coverage": {
      "additionalProperties": false,
      "description": "How much of the library the enumeration actually counted.",
      "properties": {
        "counted_items": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Counted Items"
        },
        "counted_bytes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Counted Bytes"
        },
        "root_bytes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Root Bytes"
        },
        "ratio": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Ratio"
        }
      },
      "required": [
        "counted_items",
        "counted_bytes",
        "root_bytes",
        "ratio"
      ],
      "title": "Coverage",
      "type": "object"
    },
    "Depth": {
      "additionalProperties": false,
      "description": "Folder depth: deepest level and the 50th and 90th percentiles.",
      "properties": {
        "max": {
          "minimum": 0,
          "title": "Max",
          "type": "integer"
        },
        "p50": {
          "minimum": 0,
          "title": "P50",
          "type": "integer"
        },
        "p90": {
          "minimum": 0,
          "title": "P90",
          "type": "integer"
        }
      },
      "required": [
        "max",
        "p50",
        "p90"
      ],
      "title": "Depth",
      "type": "object"
    },
    "ExposureTotal": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "ok",
            "partial_caller_scoped",
            "unknown",
            "forbidden",
            "not_run",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        },
        "checked": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Checked"
        },
        "items_with_anyone_link": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Items With Anyone Link"
        },
        "items_with_org_link": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Items With Org Link"
        },
        "items_with_people_link": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Items With People Link"
        },
        "items_with_direct_grants": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Items With Direct Grants"
        },
        "items_with_guest_or_external": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Items With Guest Or External"
        },
        "items_with_eeeu": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Items With Eeeu"
        },
        "items_differing_from_root": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Items Differing From Root"
        },
        "caller_is_owner": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Caller Is Owner"
        }
      },
      "required": [
        "status",
        "checked",
        "items_with_anyone_link",
        "items_with_org_link",
        "items_with_people_link",
        "items_with_direct_grants",
        "items_with_guest_or_external",
        "items_with_eeeu",
        "items_differing_from_root",
        "caller_is_owner"
      ],
      "title": "ExposureTotal",
      "type": "object"
    },
    "ExtensionShare": {
      "additionalProperties": false,
      "properties": {
        "ext": {
          "title": "Ext",
          "type": "string"
        },
        "share": {
          "maximum": 1,
          "minimum": 0,
          "title": "Share",
          "type": "number"
        }
      },
      "required": [
        "ext",
        "share"
      ],
      "title": "ExtensionShare",
      "type": "object"
    },
    "FolderPattern": {
      "additionalProperties": false,
      "description": "A naming pattern recognised at one folder depth.",
      "properties": {
        "depth": {
          "maximum": 4,
          "minimum": 1,
          "title": "Depth",
          "type": "integer"
        },
        "kind": {
          "enum": [
            "year",
            "fiscal_year",
            "quarter",
            "month",
            "date",
            "numeric_id",
            "categorical"
          ],
          "title": "Kind",
          "type": "string"
        },
        "share": {
          "maximum": 1,
          "minimum": 0,
          "title": "Share",
          "type": "number"
        },
        "distinct": {
          "minimum": 0,
          "title": "Distinct",
          "type": "integer"
        },
        "examples": {
          "items": {
            "type": "string"
          },
          "maxItems": 10,
          "title": "Examples",
          "type": "array"
        }
      },
      "required": [
        "depth",
        "kind",
        "share",
        "distinct",
        "examples"
      ],
      "title": "FolderPattern",
      "type": "object"
    },
    "GraphStats": {
      "additionalProperties": false,
      "description": "Counters for the Graph traffic of one run, in the order of the spec example.",
      "properties": {
        "requests": {
          "minimum": 0,
          "title": "Requests",
          "type": "integer"
        },
        "batches": {
          "minimum": 0,
          "title": "Batches",
          "type": "integer"
        },
        "throttled": {
          "minimum": 0,
          "title": "Throttled",
          "type": "integer"
        },
        "retries": {
          "minimum": 0,
          "title": "Retries",
          "type": "integer"
        },
        "seconds": {
          "minimum": 0,
          "title": "Seconds",
          "type": "number"
        }
      },
      "required": [
        "requests",
        "batches",
        "throttled",
        "retries",
        "seconds"
      ],
      "title": "GraphStats",
      "type": "object"
    },
    "InputRecord": {
      "additionalProperties": false,
      "description": "The input row this fact sheet was collected for.",
      "properties": {
        "raw": {
          "title": "Raw",
          "type": "string"
        },
        "normalized": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Normalized"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Label"
        },
        "business_unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Business Unit"
        },
        "owner_hint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Owner Hint"
        },
        "priority": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Priority"
        },
        "extra": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Extra",
          "type": "object"
        }
      },
      "required": [
        "raw",
        "normalized",
        "label",
        "business_unit",
        "owner_hint",
        "priority",
        "extra"
      ],
      "title": "InputRecord",
      "type": "object"
    },
    "LargestFile": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "bytes": {
          "minimum": 0,
          "title": "Bytes",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "bytes"
      ],
      "title": "LargestFile",
      "type": "object"
    },
    "Library": {
      "additionalProperties": false,
      "description": "One document library (or pages library) and the evidence collected from it.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "drive_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Drive Id"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "kind": {
          "enum": [
            "library",
            "pages"
          ],
          "title": "Kind",
          "type": "string"
        },
        "files": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Files"
        },
        "folders": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Folders"
        },
        "bytes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Bytes"
        },
        "truncated": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Truncated"
        },
        "truncated_reason": {
          "anyOf": [
            {
              "enum": [
                "cap",
                "time",
                "throttle",
                "resync"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Truncated Reason"
        },
        "coverage": {
          "anyOf": [
            {
              "$ref": "#/$defs/Coverage"
            },
            {
              "type": "null"
            }
          ]
        },
        "path_unresolved": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Path Unresolved"
        },
        "depth": {
          "anyOf": [
            {
              "$ref": "#/$defs/Depth"
            },
            {
              "type": "null"
            }
          ]
        },
        "categories": {
          "anyOf": [
            {
              "$ref": "#/$defs/CategoryShares"
            },
            {
              "type": "null"
            }
          ]
        },
        "top_extensions": {
          "items": {
            "$ref": "#/$defs/ExtensionShare"
          },
          "title": "Top Extensions",
          "type": "array"
        },
        "age": {
          "anyOf": [
            {
              "$ref": "#/$defs/AgeBuckets"
            },
            {
              "type": "null"
            }
          ]
        },
        "created_by_year": {
          "additionalProperties": {
            "minimum": 0,
            "type": "integer"
          },
          "title": "Created By Year",
          "type": "object"
        },
        "last_activity": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Last Activity"
        },
        "last_activity_sources": {
          "items": {
            "enum": [
              "file",
              "list",
              "page",
              "drive"
            ],
            "type": "string"
          },
          "title": "Last Activity Sources",
          "type": "array"
        },
        "largest_files": {
          "items": {
            "$ref": "#/$defs/LargestFile"
          },
          "title": "Largest Files",
          "type": "array"
        },
        "duplicate_rate": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Duplicate Rate"
        },
        "hash_coverage": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Hash Coverage"
        },
        "columns": {
          "items": {
            "$ref": "#/$defs/Column"
          },
          "title": "Columns",
          "type": "array"
        },
        "mean_fill_rate": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Mean Fill Rate"
        },
        "fill_rate_method": {
          "anyOf": [
            {
              "const": "first_n",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Fill Rate Method"
        },
        "fill_rate_sample": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Fill Rate Sample"
        },
        "content_types": {
          "items": {
            "type": "string"
          },
          "title": "Content Types",
          "type": "array"
        },
        "default_content_types_only": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Default Content Types Only"
        },
        "folder_patterns": {
          "items": {
            "$ref": "#/$defs/FolderPattern"
          },
          "title": "Folder Patterns",
          "type": "array"
        },
        "exposure": {
          "$ref": "#/$defs/LibraryExposure"
        }
      },
      "required": [
        "id",
        "drive_id",
        "name",
        "kind",
        "files",
        "folders",
        "bytes",
        "truncated",
        "truncated_reason",
        "coverage",
        "path_unresolved",
        "depth",
        "categories",
        "top_extensions",
        "age",
        "created_by_year",
        "last_activity",
        "last_activity_sources",
        "largest_files",
        "duplicate_rate",
        "hash_coverage",
        "columns",
        "mean_fill_rate",
        "fill_rate_method",
        "fill_rate_sample",
        "content_types",
        "default_content_types_only",
        "folder_patterns",
        "exposure"
      ],
      "title": "Library",
      "type": "object"
    },
    "LibraryExposure": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "ok",
            "partial_caller_scoped",
            "unknown",
            "forbidden",
            "not_run",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        },
        "checked": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Checked"
        },
        "items_with_anyone_link": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Items With Anyone Link"
        },
        "items_with_org_link": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Items With Org Link"
        },
        "items_with_people_link": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Items With People Link"
        },
        "items_with_direct_grants": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Items With Direct Grants"
        },
        "items_with_guest_or_external": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Items With Guest Or External"
        },
        "items_with_eeeu": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Items With Eeeu"
